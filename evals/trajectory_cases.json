                  "updated": "2026-11-10 10:00:00"}}
    ],
    "expect": {"must_call": ["get_mtr_next_train"], "max_tool_calls": 3,
               "facts": ["往寶琳嘅下一班車大約 7 分鐘後（10:07）到"],
               "must_not_claim": ["將往北角方向嘅 4 分鐘當成往寶琳"]}
